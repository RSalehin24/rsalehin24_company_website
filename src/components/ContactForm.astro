---
import DirectContact from './DirectContact.astro';
import { content, pagePath, type Lang } from '../data/site';
import { formEndpoint } from '../lib/form-config.mjs';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const localizedContent = content[lang];
const contactLabels = localizedContent.contact;
const endpoint = formEndpoint(import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || '');
---
{endpoint ? <div class="contact-form-panel">
  <h2>{contactLabels.formTitle}</h2>
  <p>{contactLabels.formIntro}</p>
  <p class="form-note">{contactLabels.required}</p>
  <form action={endpoint} method="POST" data-contact-form data-progress={contactLabels.progress} data-success={contactLabels.success} data-error={contactLabels.error} data-invalid={contactLabels.invalid} data-required-error={contactLabels.requiredError} data-email-error={contactLabels.emailError} data-long-error={contactLabels.tooLongError} data-sending={contactLabels.sending} data-submit-label={contactLabels.submit}>
    <div class="form-grid">
      <div class="form-field">
        <label for="name">{contactLabels.name} <span aria-hidden="true">*</span>
        </label>
        <input id="name" name="name" autocomplete="name" required maxlength="120" aria-describedby="name-error" />
        <span class="field-error" id="name-error"></span>
      </div>
      <div class="form-field">
        <label for="email">{contactLabels.email} <span aria-hidden="true">*</span>
        </label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="email-error" />
        <span class="field-error" id="email-error"></span>
      </div>
      <div class="form-field">
        <label for="company">{contactLabels.company}</label>
        <input id="company" name="company" autocomplete="organization" maxlength="160" aria-describedby="company-error" />
        <span class="field-error" id="company-error"></span>
      </div>
      <div class="form-field">
        <label for="phone">{contactLabels.phone}</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="50" aria-describedby="phone-error" />
        <span class="field-error" id="phone-error"></span>
      </div>
    </div>
    <div class="form-field">
      <label for="service">{contactLabels.service} <span aria-hidden="true">*</span>
      </label>
      <select id="service" name="service" required aria-describedby="service-error">
        <option value="">{contactLabels.servicePlaceholder}</option>{localizedContent.serviceItems.map(item => <option value={item.id}>{item.title}</option>)}<option value="other">{contactLabels.otherService}</option>
      </select>
      <span class="field-error" id="service-error"></span>
    </div>
    <div class="form-field">
      <label for="message">{contactLabels.message} <span aria-hidden="true">*</span>
      </label>
      <p class="form-note" id="message-hint">{contactLabels.messageHint}</p>
      <textarea id="message" name="message" required rows="6" maxlength="5000" aria-describedby="message-hint message-error"></textarea>
      <span class="field-error" id="message-error"></span>
    </div>
    <div class="honeypot" aria-hidden="true">
      <label for="website">Leave this field empty</label>
      <input id="website" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <input type="hidden" name="_subject" value="RSalehin24 project inquiry" />
    <input type="hidden" name="language" value={lang} />
    <p class="form-note privacy-note">{contactLabels.privacyBefore} <a href={pagePath(lang,'privacy')}>{contactLabels.privacyLink}</a>{contactLabels.privacyAfter}</p>
    <p class="form-feedback" role="status" aria-live="polite" aria-atomic="true" tabindex="-1" data-form-status></p>
    <button type="submit" class="button">{contactLabels.submit}</button>
    <noscript>
      <p class="form-note">{contactLabels.nojs}</p>
    </noscript>
  </form>
</div> : <DirectContact lang={lang} />}
<script src="../scripts/contact.ts"></script>
