---
import ForestImage from '../ForestImage.astro';
import Cta from '../Cta.astro';
import { content, pagePath, type Lang } from '../../data/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const localizedContent = content[lang];
---
<section class="about-story wrap">
  <figure>
    <ForestImage alt={localizedContent.ui.photoAlt} />
    <figcaption>{localizedContent.ui.photoCredit}</figcaption>
  </figure>
  <div class="story-copy">
    <h2>{localizedContent.about.heading}</h2>
    <p>{localizedContent.about.text}</p>
    <a class="text-link" href={pagePath(lang,'products')}>{localizedContent.about.link}</a>
    <h2>{localizedContent.about.heading2}</h2>
    <p>{localizedContent.about.text2}</p>
  </div>
</section>
<section class="principles section wrap">
  <div class="service-grid">{localizedContent.about.principles.map((item,index) => <article class="service-summary">
      <span class="section-number" aria-hidden="true">0{index+1} /</span>
      <h2>{item.title}</h2>
      <p>{item.text}</p>
    </article>)}</div>
</section>
<Cta lang={lang} title={localizedContent.about.ctaTitle} text={localizedContent.about.ctaText} />
