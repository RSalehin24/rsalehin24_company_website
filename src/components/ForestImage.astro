---
import { Picture } from 'astro:assets';
import forest from '../assets/forest-lake.jpg';
interface Props { alt: string; eager?: boolean; class?: string; }
const { alt, eager = false, class: className = '' } = Astro.props;
---
<Picture src={forest} alt={alt} formats={['webp']} width={1600} height={1600} fit="cover" widths={[480, 800, 1200, 1600]} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 90vw, 75vw" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} quality={70} class={className} />
