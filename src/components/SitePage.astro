---
import PageLayout from '../layouts/PageLayout.astro';
import PageIntro from './PageIntro.astro';
import HomePage from './pages/HomePage.astro';
import ServicesPage from './pages/ServicesPage.astro';
import ProductsPage from './pages/ProductsPage.astro';
import AboutPage from './pages/AboutPage.astro';
import ContactPage from './pages/ContactPage.astro';
import PrivacyPage from './pages/PrivacyPage.astro';
import type { Lang, PageKey } from '../data/site';

interface Props { lang: Lang; page: PageKey; }
const { lang, page } = Astro.props;
const pages = {
  home: HomePage,
  services: ServicesPage,
  products: ProductsPage,
  about: AboutPage,
  contact: ContactPage,
  privacy: PrivacyPage,
} satisfies Record<PageKey, typeof HomePage>;
const PageContent = pages[page];
---
<PageLayout lang={lang} page={page}>
  {page !== 'home' && <PageIntro lang={lang} page={page} />}
  <PageContent lang={lang} />
</PageLayout>
