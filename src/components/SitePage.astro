---
import PageLayout from '../layouts/PageLayout.astro';
import ForestImage from './ForestImage.astro';
import ProductCard from './ProductCard.astro';
import ContactForm from './ContactForm.astro';
import Cta from './Cta.astro';
import { company, content, pagePath, type Lang, type PageKey } from '../data/site';
interface Props { lang: Lang; page: PageKey; }
const { lang, page } = Astro.props; const c = content[lang];
const section = page === 'home' ? c.home : c[page];
const label = page === 'services' ? c.ui.serviceLabel : page === 'products' ? c.ui.productLabel : page === 'about' ? c.ui.aboutLabel : page === 'contact' ? c.ui.contactLabel : c.ui.privacyLabel;
---
<PageLayout lang={lang} page={page}>
 {page === 'home' ? <>
  <section class="hero wrap">
   <div class="hero-landscape"><ForestImage alt={c.ui.photoAlt} eager /></div>
   <div class="hero-content"><p class="eyebrow">{c.home.eyebrow}</p><h1>{c.home.title}<br /><em>{c.home.accent}</em></h1><p class="hero-intro">{c.home.intro}</p><div class="hero-actions"><a class="button" href={pagePath(lang,'contact')}>{c.ui.discuss}</a><a class="text-link" href={pagePath(lang,'services')}>{c.home.secondary}</a></div><p class="hero-note">{c.home.note}</p></div>
   <div class="hero-caption" aria-hidden="true"><span class="caption-line"></span><span>{c.home.imageNote}</span></div>
  </section>
  <section class="service-overview section wrap">
   <div class="section-heading"><div><p class="eyebrow">{c.ui.serviceLabel}</p><h2>{c.home.servicesTitle}<br /><em>{c.home.servicesAccent}</em></h2></div><p>{c.home.servicesIntro}</p></div>
   <div class="service-grid">{c.serviceItems.map((item,i) => <article class="service-summary"><span class="section-number" aria-hidden="true">0{i+1} /</span><h3>{item.title}</h3><p>{item.short}</p><a class="text-link" href={pagePath(lang,'services')+'#'+item.id}>{c.ui.learn}<span class="sr-only"> — {item.title}</span></a></article>)}</div>
  </section>
  <section class="products-section section"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">{c.ui.productLabel}</p><h2>{c.home.productsTitle}</h2></div><p>{c.home.productsIntro}</p></div><div class="product-grid">{c.productItems.map((_,i) => <ProductCard lang={lang} index={i} />)}</div><a class="text-link section-link" href={pagePath(lang,'products')}>{c.ui.productsLink}</a></div></section>
  <section class="process-section section wrap"><p class="eyebrow">{c.ui.processLabel}</p><h2>{c.home.processTitle}<br /><em>{c.home.processAccent}</em></h2><ol class="process-grid">{c.process.map((item,i) => <li><span class="section-number" aria-hidden="true">0{i+1}</span><h3>{item.title}</h3><p>{item.text}</p></li>)}</ol></section>
  <Cta lang={lang} title={c.about.ctaTitle} text={c.about.ctaText} />
 </> : <>
  <section class="page-intro wrap"><p class="eyebrow">{label}</p><h1>{section.title}<br /><em>{section.accent}</em></h1><p>{section.intro}</p></section>
  {page === 'services' && <>
   <div class="service-details wrap">{c.serviceItems.map((item,i) => <section class="service-detail" id={item.id}><div class="service-detail-main"><span class="section-number" aria-hidden="true">0{i+1} /</span><h2>{item.title}</h2><p>{item.description}</p><a class="text-link" href={pagePath(lang,'contact')+'?service='+item.id}>{c.ui.inquiry}<span class="sr-only"> — {item.title}</span></a></div><div class="service-detail-benefits"><h3>{c.services.benefitLabel}</h3><ul class="feature-list">{item.benefits.map(benefit => <li>{benefit}</li>)}</ul><h3>{c.services.fitLabel}</h3><p>{item.fit}</p></div></section>)}</div>
   <section class="process-section section wrap"><p class="eyebrow">{c.ui.processLabel}</p><h2>{c.home.processTitle} <em>{c.home.processAccent}</em></h2><ol class="process-grid">{c.process.map((item,i) => <li><span class="section-number" aria-hidden="true">0{i+1}</span><h3>{item.title}</h3><p>{item.text}</p></li>)}</ol></section>
   <Cta lang={lang} title={c.services.ctaTitle} text={c.services.ctaText} />
  </>}
  {page === 'products' && <><section class="wrap product-list"><p class="stage-note">{c.products.stageNote}</p><div class="product-grid">{c.productItems.map((_,i) => <ProductCard lang={lang} index={i} detailed />)}</div></section><Cta lang={lang} title={c.products.ctaTitle} text={c.products.ctaText} /></>}
  {page === 'about' && <>
   <section class="about-story wrap"><figure><ForestImage alt={c.ui.photoAlt} /><figcaption>{c.ui.photoCredit}</figcaption></figure><div class="story-copy"><h2>{c.about.heading}</h2><p>{c.about.text}</p><a class="text-link" href={pagePath(lang,'products')}>{c.about.link}</a><h2>{c.about.heading2}</h2><p>{c.about.text2}</p></div></section>
   <section class="principles section wrap"><div class="service-grid">{c.about.principles.map((item,i) => <article class="service-summary"><span class="section-number" aria-hidden="true">0{i+1} /</span><h2>{item.title}</h2><p>{item.text}</p></article>)}</div></section>
   <Cta lang={lang} title={c.about.ctaTitle} text={c.about.ctaText} />
  </>}
  {page === 'contact' && <section class="contact-layout wrap"><div class="direct-details"><h2>{c.contact.directTitle}</h2><dl><div><dt>{c.contact.emailLabel}</dt><dd><a href={'mailto:'+company.email}>{company.email}</a></dd></div><div><dt>{c.contact.phoneLabel}</dt><dd><a href={'tel:'+company.phone}>{company.phone}</a></dd></div><div><dt>{c.contact.addressLabel}</dt><dd><address>{company.address[lang]}</address></dd></div></dl></div><ContactForm lang={lang} /></section>}
  {page === 'privacy' && <article class="privacy-content wrap">{c.privacy.sections.map(item => <section><h2>{item.heading}</h2><p>{item.text}</p></section>)}<div class="provider-links"><a href="https://formspree.io/legal/privacy-policy/">{c.privacy.providerLabel}</a><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">{c.privacy.hostLabel}</a></div></article>}
 </>}
</PageLayout>
