{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "rsalehin24-contact",
  "main": "index.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": true,
  "vars": { "BREVO_SENDER_EMAIL": "website@rsalehin24.me", "BREVO_SENDER_ID": "10" },
  "durable_objects": {
    "bindings": [{ "name": "INQUIRY_COUNTER", "class_name": "InquiryCounter" }]
  },
  "migrations": [{ "tag": "inquiry-counter-v1", "new_sqlite_classes": ["InquiryCounter"] }],
  "observability": { "enabled": false }
}
